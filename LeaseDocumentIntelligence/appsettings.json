{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity.Web": "Information",
      "LeaseDocumentIntelligence": "Information"
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": "InstrumentationKey=<your-instrumentation-key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/"
  },
  "KeyVault": {
    "VaultUri": "https://leaseintelligencepoc.vault.azure.net/",
    "CacheDurationMinutes": 5
  },
  "BlobStorage": {
    "StorageAccountUri": "https://leaseintelligencepoc.blob.core.windows.net/",
    "ContainerName": "lease-documents"
  },
  "CosmosDb": {
    "Endpoint": "https://leasedocument.documents.azure.com:443/",
    "DatabaseName": "LeaseDocuments",
    "ContainerName": "Metadata"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-id>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "Scopes": [ "openid", "profile", "offline_access" ]
  },
  "Foundry": {
    "Endpoint": "https://<foundry-resource-name>.openai.azure.com/",
    "ModelName": "gpt-4",
    "ApiVersion": "2024-02-15-preview",
    "UseLocalTesting": false
  },
  "FileUpload": {
    "MaxFileSizeBytes": 52428800,
    "AllowedContentTypes": ["application/pdf"]
  },
  "Authorization": {
    "Roles": {
      "Admin": "Administrator who manages users and system settings",
      "LeaseAnalyst": "Can upload documents and extract lease fields",
      "Reviewer": "Can review and approve extracted fields",
      "Viewer": "Can view extraction results but cannot modify"
    }
  }
}
