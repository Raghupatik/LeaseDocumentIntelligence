@page "/upload"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient HttpClient
@inject NavigationManager Navigation

<PageTitle>Upload Lease Document</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">

            <h2 class="mb-4">
                <i class="bi bi-file-earmark-pdf me-2"></i>Upload Lease Document
            </h2>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="alert alert-info" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        Upload commercial lease documents in PDF format.
                    </div>

                    <div class="mb-4">
                        <label for="fileInput" class="form-label fw-bold">Select PDF File</label>
                        <InputFile id="fileInput" class="form-control form-control-lg" 
                                  OnChange="OnFileChange" 
                                  accept=".pdf" />

                        @if (selectedFile != null)
                        {
                            <div class="alert alert-success mt-3">
                                <i class="bi bi-check-circle me-2"></i>
                                <strong>@selectedFile.Name</strong> (@FormatFileSize(selectedFile.Size))
                            </div>
                        }
                    </div>

                    <button type="button" 
                            class="btn btn-primary btn-lg w-100" 
                            disabled="@IsButtonDisabled"
                            @onclick="HandleFileUpload">
                        @if (isUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <i class="bi bi-cloud-upload me-2"></i>
                            <span>Upload & Extract</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3">
                            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success mt-3">
                            <i class="bi bi-check-circle me-2"></i>@successMessage
                            <br/><small>Document ID: <code>@uploadedDocumentId</code></small>
                        </div>
                    }
                </div>
            </div>

            <div class="card mt-4 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-gear me-2"></i>How It Works</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Process:</h6>
                            <ol>
                                <li>Upload PDF lease document</li>
                                <li>AI extracts 40-60 key fields</li>
                                <li>Low-confidence items flagged</li>
                                <li>View results with citations</li>
                            </ol>
                        </div>
                        <div class="col-md-6">
                            <h6>Extracted Fields:</h6>
                            <ul class="list-unstyled">
                                <li><i class="bi bi-check text-success me-1"></i>Base rent & escalations</li>
                                <li><i class="bi bi-check text-success me-1"></i>Lease dates</li>
                                <li><i class="bi bi-check text-success me-1"></i>Renewal options</li>
                                <li><i class="bi bi-check text-success me-1"></i>CAM expenses</li>
                                <li><i class="bi bi-check text-success me-1"></i>Security deposits</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

@code {
    private IBrowserFile? selectedFile;
    private bool isUploading;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private Guid uploadedDocumentId;

    private bool IsButtonDisabled => selectedFile == null || isUploading;

    private void OnFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private async Task HandleFileUpload()
    {
        if (selectedFile == null)
        {
            errorMessage = "Please select a file";
            return;
        }

        if (!selectedFile.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Only PDF files are supported";
            return;
        }

        isUploading = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            using var content = new MultipartFormDataContent();
            using var fileStream = selectedFile.OpenReadStream(500 * 1024 * 1024);
            content.Add(new StreamContent(fileStream), "file", selectedFile.Name);

            var response = await HttpClient.PostAsync("api/lease/upload", content);

            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                if (Guid.TryParse(json.Trim('"'), out var documentId))
                {
                    uploadedDocumentId = documentId;
                        successMessage = "Extraction complete!";
                        selectedFile = null;
                        Navigation.NavigateTo($"/results/{documentId}");
                }
                else
                {
                    errorMessage = "Invalid response from server";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Upload failed: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
