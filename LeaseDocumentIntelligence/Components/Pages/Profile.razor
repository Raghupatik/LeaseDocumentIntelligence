@page "/profile"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<PageTitle>User Profile - Lease Document Intelligence</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="container mt-4">
            <div class="row">
                <div class="col-md-8">
                    <h2>User Profile</h2>

                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="mb-0">Account Information</h5>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-sm-3">
                                    <strong>Name:</strong>
                                </div>
                                <div class="col-sm-9">
                                    @context.User.Identity?.Name
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-3">
                                    <strong>Email:</strong>
                                </div>
                                <div class="col-sm-9">
                                    @(context.User.FindFirst("preferred_username")?.Value ?? "Not available")
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-sm-3">
                                    <strong>Object ID:</strong>
                                </div>
                                <div class="col-sm-9">
                                    <code>@(context.User.FindFirst("oid")?.Value ?? "Not available")</code>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="mb-0">Assigned Roles</h5>
                        </div>
                        <div class="card-body">
                            @{
                                var roles = context.User.FindAll("roles").ToList();
                                if (roles.Count > 0)
                                {
                                    <ul class="list-group">
                                        @foreach (var role in roles)
                                        {
                                            var badgeColor = role.Value switch
                                            {
                                                "Admin" => "danger",
                                                "LeaseAnalyst" => "primary",
                                                "Reviewer" => "info",
                                                "Viewer" => "secondary",
                                                _ => "light"
                                            };
                                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                                @role.Value
                                                <span class="badge bg-@badgeColor">Active</span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        No roles assigned. Contact your administrator.
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="card mt-4">
                        <div class="card-header">
                            <h5 class="mb-0">Permissions</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Feature</th>
                                        <th>Permission</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Upload Documents</td>
                                        <td>
                                            @if (context.User.IsInRole("Admin") || context.User.IsInRole("LeaseAnalyst"))
                                            {
                                                <span class="badge bg-success">✓ Allowed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">✗ Denied</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Review & Approve</td>
                                        <td>
                                            @if (context.User.IsInRole("Admin") || context.User.IsInRole("Reviewer"))
                                            {
                                                <span class="badge bg-success">✓ Allowed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">✗ Denied</span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>View Results</td>
                                        <td>
                                            <span class="badge bg-success">✓ Allowed</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Manage Users</td>
                                        <td>
                                            @if (context.User.IsInRole("Admin"))
                                            {
                                                <span class="badge bg-success">✓ Allowed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">✗ Denied</span>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="/" class="btn btn-primary">Back to Dashboard</a>
                        <a href="https://login.microsoftonline.com/common/oauth2/v2.0/logout" class="btn btn-danger">Sign Out</a>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container mt-4">
            <div class="alert alert-warning">
                <h4>Not Authenticated</h4>
                <p>You must log in to view your profile.</p>
                <a href="/login" class="btn btn-primary">Go to Login</a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>
