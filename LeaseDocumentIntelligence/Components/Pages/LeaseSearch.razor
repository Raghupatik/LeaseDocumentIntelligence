@page "/search"
@using LeaseDocumentIntelligence.Domain.DTOs
@using LeaseDocumentIntelligence.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IVectorSearchService SearchService
@inject NavigationManager Navigation
@inject HttpClient Http
@rendermode InteractiveServer

<PageTitle>Lease Search - AI Assistant</PageTitle>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Search Header -->
            <div class="text-center mb-4">
                <h2 class="mb-2">
                    <i class="bi bi-search me-2"></i>Ask About Your Leases
                </h2>
                <p class="text-muted">
                    Ask natural language questions about your lease documents
                </p>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ReindexDocuments" disabled="@IsReindexing">
                    @if (IsReindexing)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Reindexing...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-repeat me-1"></i>
                        <span>Refresh Search Index</span>
                    }
                </button>
                @if (!string.IsNullOrEmpty(ReindexMessage))
                {
                    <div class="alert alert-info alert-dismissible mt-2 py-1 px-2 small">
                        @ReindexMessage
                        <button type="button" class="btn-close btn-sm" @onclick="() => ReindexMessage = null"></button>
                    </div>
                }
            </div>

            <!-- Search Input -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-primary text-white">
                            <i class="bi bi-chat-dots"></i>
                        </span>
                        <input type="text" 
                               class="form-control" 
                               placeholder="e.g., When does my lease end? What are the renewal terms? Show me all CAM clauses..."
                               @bind="SearchQuery"
                               @bind:event="oninput"
                               @onkeypress="HandleKeyPress" />
                        <button class="btn btn-primary px-4" @onclick="PerformSearch" disabled="@IsSearching">
                            @if (IsSearching)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Searching...</span>
                            }
                            else
                            {
                                <i class="bi bi-send me-2"></i>
                                <span>Ask</span>
                            }
                        </button>
                    </div>

                    <!-- Example Questions -->
                    <div class="mt-3">
                        <small class="text-muted">Try asking:</small>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @foreach (var example in ExampleQuestions)
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => SetQuestion(example)">
                                    @example
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Property Selection (if multiple matches) -->
            @if (ShowPropertySelector && SearchResults?.SearchResults?.Hits?.Count > 1)
            {
                <div class="card border-warning mb-4">
                    <div class="card-header bg-warning text-dark">
                        <i class="bi bi-building me-2"></i>
                        Multiple properties found - Please select one:
                    </div>
                    <div class="card-body">
                        <div class="list-group">
                            @foreach (var hit in SearchResults.SearchResults.Hits)
                            {
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                        @onclick="() => SelectProperty(hit)">
                                    <div>
                                        <strong>@hit.PropertyName</strong>
                                        <br />
                                        <small class="text-muted">Tenant: @hit.TenantName | File: @hit.FileName</small>
                                    </div>
                                    <span class="badge bg-primary rounded-pill">@hit.Score.ToString("P0") match</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- AI Response -->
            @if (SearchResults != null && !string.IsNullOrEmpty(SearchResults.Summary))
            {
                <div class="card shadow mb-4">
                    <div class="card-header bg-success text-white">
                        <i class="bi bi-robot me-2"></i>AI Response
                    </div>
                    <div class="card-body">
                        <!-- Summary -->
                        <div class="mb-4">
                            <h5>Summary</h5>
                            <p class="lead">@SearchResults.Summary</p>
                        </div>

                        <!-- Reasoning -->
                        @if (!string.IsNullOrEmpty(SearchResults.Reasoning))
                        {
                            <div class="mb-4">
                                <h5>Analysis</h5>
                                <p>@SearchResults.Reasoning</p>
                            </div>
                        }

                        <!-- Key Insights -->
                        @if (SearchResults.KeyInsights?.Count > 0)
                        {
                            <div class="mb-4">
                                <h5><i class="bi bi-lightbulb me-2"></i>Key Insights</h5>
                                <ul class="list-group list-group-flush">
                                    @foreach (var insight in SearchResults.KeyInsights)
                                    {
                                        <li class="list-group-item">
                                            <i class="bi bi-check-circle text-success me-2"></i>@insight
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <!-- Citations -->
                        @if (SearchResults.Citations?.Count > 0)
                        {
                            <div class="mb-4">
                                <h5><i class="bi bi-quote me-2"></i>Sources</h5>
                                <div class="accordion" id="citationsAccordion">
                                    @for (int i = 0; i < SearchResults.Citations.Count; i++)
                                    {
                                        var citation = SearchResults.Citations[i];
                                        var collapseId = $"citation{i}";
                                        <div class="accordion-item">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed" type="button" 
                                                        data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                                    <i class="bi bi-file-earmark-text me-2"></i>@citation.FileName
                                                    @if (citation.PageNumber.HasValue)
                                                    {
                                                        <span class="badge bg-secondary ms-2">Page @citation.PageNumber</span>
                                                    }
                                                </button>
                                            </h2>
                                            <div id="@collapseId" class="accordion-collapse collapse" 
                                                 data-bs-parent="#citationsAccordion">
                                                <div class="accordion-body">
                                                    <blockquote class="blockquote">
                                                        <p class="mb-0 fst-italic">"@citation.Excerpt"</p>
                                                    </blockquote>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Suggested Follow-up Questions -->
                        @if (SearchResults.SuggestedQuestions?.Count > 0)
                        {
                            <div>
                                <h5><i class="bi bi-question-circle me-2"></i>You might also ask:</h5>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var question in SearchResults.SuggestedQuestions)
                                    {
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => SetQuestion(question)">
                                            @question
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Matching Documents -->
            @if (SearchResults?.SearchResults?.Hits?.Count > 0 && SelectedProperty != null)
            {
                <div class="card shadow">
                    <div class="card-header">
                        <i class="bi bi-file-earmark-text me-2"></i>Extracted Fields from: @SelectedProperty.FileName
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var field in SelectedProperty.ExtractedFields)
                                    {
                                        <tr>
                                            <td><strong>@field.Key</strong></td>
                                            <td>@field.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- No Results -->
            @if (HasSearched && (SearchResults == null || SearchResults.SearchResults?.Hits?.Count == 0))
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    No matching documents found. Try uploading lease documents first or rephrase your question.
                </div>
            }

            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string SearchQuery { get; set; } = string.Empty;
    private ReasonedSearchResultDto? SearchResults { get; set; }
    private SearchHitDto? SelectedProperty { get; set; }
    private bool IsSearching { get; set; }
    private bool HasSearched { get; set; }
    private bool ShowPropertySelector { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsReindexing { get; set; }
    private string? ReindexMessage { get; set; }

    private readonly string[] ExampleQuestions =
    [
        "When does my lease end?",
        "What is my monthly rent?",
        "What are the renewal options?",
        "Show me CAM charges",
        "What is the security deposit?"
    ];

    private void SetQuestion(string question)
    {
        SearchQuery = question;
        StateHasChanged();
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await PerformSearch();
        }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery))
            return;

        IsSearching = true;
        HasSearched = true;
        ErrorMessage = null;
        SearchResults = null;
        SelectedProperty = null;
        ShowPropertySelector = false;
        StateHasChanged();

        try
        {
            var options = new LeaseSearchOptions
            {
                Top = 10,
                UseHybridSearch = true
            };

            SearchResults = await SearchService.SearchWithReasoningAsync(SearchQuery, options);

            // If only one result, auto-select it
            if (SearchResults?.SearchResults?.Hits?.Count == 1)
            {
                SelectedProperty = SearchResults.SearchResults.Hits[0];
            }
            else if (SearchResults?.SearchResults?.Hits?.Count > 1)
            {
                ShowPropertySelector = true;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Search failed: {ex.Message}";
        }
        finally
        {
            IsSearching = false;
            StateHasChanged();
        }
    }

    private void SelectProperty(SearchHitDto property)
    {
        SelectedProperty = property;
        ShowPropertySelector = false;
        StateHasChanged();
    }

    private async Task ReindexDocuments()
    {
        IsReindexing = true;
        ReindexMessage = null;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync("api/search/reindex", null);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadAsStringAsync();
                ReindexMessage = "✓ Search index refreshed successfully! Try your search again.";
            }
            else
            {
                ReindexMessage = $"Reindex failed: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            ReindexMessage = $"Error: {ex.Message}";
        }
        finally
        {
            IsReindexing = false;
            StateHasChanged();
        }
    }
}
