@page "/results"
@rendermode InteractiveServer
@using LeaseDocumentIntelligence.Domain.Models
@inject HttpClient HttpClient
@inject NavigationManager Navigation

<PageTitle>Extraction Results</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-list-check me-2"></i>Extraction Results</h2>
        <a href="/upload" class="btn btn-primary">
            <i class="bi bi-upload me-1"></i>Upload New
        </a>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Loading documents...</p>
        </div>
    }
    else if (documents == null || !documents.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            No documents have been processed yet. 
            <a href="/upload" class="alert-link">Upload your first lease document</a> to get started.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Document</th>
                        <th>Status</th>
                        <th>Uploaded</th>
                        <th>Fields Extracted</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in documents)
                    {
                        <tr>
                            <td>
                                <i class="bi bi-file-earmark-pdf text-danger me-2"></i>
                                @doc.FileName
                            </td>
                            <td>
                                @switch (doc.Status)
                                {
                                    case DocumentStatus.Pending:
                                        <span class="badge bg-warning">Pending</span>
                                        break;
                                    case DocumentStatus.Processing:
                                        <span class="badge bg-info">Processing</span>
                                        break;
                                    case DocumentStatus.Completed:
                                        <span class="badge bg-success">Completed</span>
                                        break;
                                    case DocumentStatus.Failed:
                                        <span class="badge bg-danger">Failed</span>
                                        break;
                                    case DocumentStatus.ReviewRequired:
                                        <span class="badge bg-warning">Needs Review</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@doc.Status</span>
                                        break;
                                }
                            </td>
                            <td>@doc.UploadedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td>@(doc.ExtractedFields?.Count ?? 0) fields</td>
                            <td>
                                <a href="/results/@doc.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">
            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
        </div>
    }
</div>

@code {
    private List<LeaseDocument>? documents;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var response = await HttpClient.GetAsync("api/lease/list");
            if (response.IsSuccessStatusCode)
            {
                documents = await response.Content.ReadFromJsonAsync<List<LeaseDocument>>();
            }
            else
            {
                // If API returns error, show empty state
                documents = new List<LeaseDocument>();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading documents: {ex.Message}";
            documents = new List<LeaseDocument>();
        }
        finally
        {
            isLoading = false;
        }
    }
}
