@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@inherits LayoutComponentBase

<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <i class="bi bi-file-earmark-text me-2"></i>Lease AI
        </a>

        <button class="navbar-toggler" type="button" @onclick="ToggleNavMenu" 
                aria-controls="navbarNav" aria-expanded="@(!collapseNavMenu)" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="navbar-collapse @NavMenuCssClass" id="navbarNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house me-1"></i>Home
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="upload">
                        <i class="bi bi-upload me-1"></i>Upload
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="results">
                        <i class="bi bi-list-check me-1"></i>Results
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="review">
                        <i class="bi bi-clipboard-check me-1"></i>Review
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="search">
                        <i class="bi bi-chat-dots me-1"></i>Ask AI
                    </NavLink>
                </li>
            </ul>
            <div class="d-flex align-items-center">
                <AuthorizeView>
                    <Authorized Context="authContext">
                        <span class="text-light me-3">
                            <i class="bi bi-person-circle me-1"></i>@authContext.User.Identity?.Name
                        </span>
                        <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login-challenge" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Login
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</nav>

<main class="container-fluid py-4">
    @Body
</main>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : "";

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
